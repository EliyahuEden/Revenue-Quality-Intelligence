          },
          {
            "name": "invoice_ts",
            "dataType": "dateTime",
            "sourceColumn": "invoice_ts",
            "summarizeBy": "none",
            "lineageTag": "42e55e77-63a0-5bfd-ac57-4f981562d70f"
          },
          {
