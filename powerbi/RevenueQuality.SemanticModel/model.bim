            "summarizeBy": "none",
            "lineageTag": "aa693d9d-ec2a-5fc5-b226-03c5fe51cd41"
          }
        ],
        "partitions": [
          {
            "name": "fact_order",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\fact_order.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {",
                "        {\"invoice_no\", type text},",
                "        {\"customer_key\", type text},",
                "        {\"country_key\", type text},",
                "        {\"invoice_ts\", type datetime},",
                "        {\"date_key\", type date},",
                "        {\"gross_pence\", Int64.Type},",
                "        {\"line_count\", Int64.Type},",
                "        {\"distinct_products\", Int64.Type},",
                "        {\"units\", Int64.Type}",
                "    }, \"en-GB\")",
