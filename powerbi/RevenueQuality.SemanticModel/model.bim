            "isHidden": true
          },
          {
            "name": "amount_pence",
            "dataType": "int64",
            "sourceColumn": "amount_pence",
            "summarizeBy": "none",
            "lineageTag": "4382c467-a668-581f-b576-f10b67b300e2",
            "isHidden": true
          },
          {
            "name": "line_status",
            "dataType": "string",
            "sourceColumn": "line_status",
            "summarizeBy": "none",
            "lineageTag": "16684ade-cde1-545d-aa7b-c17a049d8e93"
          },
          {
            "name": "duplicate_ordinal",
            "dataType": "int64",
            "sourceColumn": "duplicate_ordinal",
            "summarizeBy": "none",
            "lineageTag": "a2062c6b-9dfb-562a-baf3-0828ffd76e56"
          }
        ],
        "partitions": [
          {
            "name": "fact_invoice_line",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\fact_invoice_line.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {",
                "        {\"line_id\", Int64.Type},",
                "        {\"invoice_no\", type text},",
                "        {\"invoice_ts\", type datetime},",
                "        {\"date_key\", type date},",
                "        {\"customer_key\", type text},",
                "        {\"product_key\", type text},",
                "        {\"country_key\", type text},",
                "        {\"quantity\", Int64.Type},",
                "        {\"unit_price\", type number},",
                "        {\"amount_pence\", Int64.Type},",
                "        {\"line_status\", type text},",
                "        {\"duplicate_ordinal\", Int64.Type}",
                "    }, \"en-GB\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "lineageTag": "3b32b545-a664-5e71-bed9-34d85f164dc6",
        "measures": [
          {
            "name": "Gross Sales GBP",
            "expression": [
              "CALCULATE ( SUM ( fact_invoice_line[amount_pence] ) / 100,",
              "    fact_invoice_line[line_status] = \"sale\",",
              "    KEEPFILTERS ( dim_date[is_complete_period] = TRUE () ) )"
            ],
            "formatString": "\u00a3#,0.00;(\u00a3#,0.00)",
            "displayFolder": "Financial performance"
          },
          {
            "name": "Cancellation Postings GBP",
            "expression": [
              "-CALCULATE ( SUM ( fact_invoice_line[amount_pence] ) / 100,",
              "    fact_invoice_line[line_status] = \"cancellation\",",
              "    KEEPFILTERS ( dim_date[is_complete_period] = TRUE () ) )"
            ],
            "formatString": "\u00a3#,0.00;(\u00a3#,0.00)",
            "displayFolder": "Financial performance"
          },
          {
            "name": "Net Merchandise GBP",
            "expression": [
              "[Gross Sales GBP] - [Cancellation Postings GBP]"
            ],
            "formatString": "\u00a3#,0.00;(\u00a3#,0.00)",
            "displayFolder": "Financial performance"
          },
          {
            "name": "Cancellation Value Ratio",
            "expression": [
              "DIVIDE ( [Cancellation Postings GBP], [Gross Sales GBP] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "Financial performance"
          },
          {
            "name": "Sale Invoices",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( fact_invoice_line[invoice_no] ),",
              "    fact_invoice_line[line_status] = \"sale\",",
              "    KEEPFILTERS ( dim_date[is_complete_period] = TRUE () ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Financial performance"
          },
          {
            "name": "Gross AOV GBP",
            "expression": [
              "DIVIDE ( [Gross Sales GBP], [Sale Invoices] )"
            ],
            "formatString": "\u00a3#,0.00;(\u00a3#,0.00)",
            "displayFolder": "Financial performance"
          },
          {
            "name": "Known Buyers",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( fact_invoice_line[customer_key] ),",
              "    fact_invoice_line[customer_key] <> \"UNKNOWN\", fact_invoice_line[line_status] = \"sale\",",
              "    KEEPFILTERS ( dim_date[is_complete_period] = TRUE () ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Customer continuity"
          },
          {
            "name": "Anonymous Gross GBP",
            "expression": [
              "CALCULATE ( [Gross Sales GBP], REMOVEFILTERS ( dim_customer ),",
              "    fact_invoice_line[customer_key] = \"UNKNOWN\" )"
            ],
            "formatString": "\u00a3#,0.00;(\u00a3#,0.00)",
            "displayFolder": "Financial performance"
          },
          {
            "name": "Anonymous Gross Share",
            "expression": [
              "DIVIDE ( [Anonymous Gross GBP], CALCULATE ( [Gross Sales GBP], REMOVEFILTERS ( dim_customer ) ) )"
            ],
            "formatString": "0.0%",
            "displayFolder": "Financial performance"
          },
          {
            "name": "Net YTD GBP",
            "expression": [
              "CALCULATE ( [Net Merchandise GBP], DATESYTD ( dim_date[date_key] ) )"
            ],
            "formatString": "\u00a3#,0.00;(\u00a3#,0.00)",
            "displayFolder": "Financial performance"
          },
          {
            "name": "Net Previous Year Month GBP",
            "expression": [
              "IF ( HASONEVALUE ( dim_date[month_start] ),",
              "    CALCULATE ( [Net Merchandise GBP], DATEADD ( dim_date[date_key], -1, YEAR ) ) )"
            ],
            "formatString": "\u00a3#,0.00;(\u00a3#,0.00)",
            "displayFolder": "Financial performance"
          },
          {
            "name": "Net YoY Month Growth",
            "expression": [
              "VAR Prior = [Net Previous Year Month GBP]",
              "RETURN IF ( NOT ISBLANK ( Prior ) && Prior > 0,",
              "    DIVIDE ( [Net Merchandise GBP] - Prior, Prior ) )"
            ],
            "formatString": "0.0%",
            "displayFolder": "Customer continuity"
          },
          {
            "name": "Snapshot Customers",
            "expression": [
              "COUNTROWS ( customer_segments )"
            ],
            "formatString": "#,0",
            "displayFolder": "Customer continuity"
          },
          {
            "name": "Snapshot Gross GBP",
            "expression": [
              "SUM ( customer_segments[gross_pence] ) / 100"
            ],
            "formatString": "\u00a3#,0.00;(\u00a3#,0.00)",
            "displayFolder": "Financial performance"
          },
          {
            "name": "Mature 90d Customers",
            "expression": [
              "CALCULATE ( COUNTROWS ( customer_lifecycle ),",
              "    customer_lifecycle[after_warmup] = TRUE (),",
              "    customer_lifecycle[fully_observed_90d] = TRUE () )"
            ],
            "formatString": "#,0",
            "displayFolder": "Customer continuity"
          },
          {
            "name": "Mature 90d Repeat Customers",
            "expression": [
              "CALCULATE ( COUNTROWS ( customer_lifecycle ),",
              "    customer_lifecycle[after_warmup] = TRUE (),",
              "    customer_lifecycle[fully_observed_90d] = TRUE (),",
              "    FILTER ( customer_lifecycle,",
              "        NOT ISBLANK ( customer_lifecycle[days_to_second_order] )",
              "        && customer_lifecycle[days_to_second_order] <= 90 ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Customer continuity"
          },
          {
            "name": "Repeat 90d Rate",
            "expression": [
              "DIVIDE ( [Mature 90d Repeat Customers], [Mature 90d Customers] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "Customer continuity"
          },
          {
            "name": "Cohort Active Buyers",
            "expression": [
              "IF ( HASONEVALUE ( cohort_retention[month_age] ), SUM ( cohort_retention[active_customers] ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Customer continuity"
          },
          {
            "name": "Cohort Eligible Buyers",
            "expression": [
              "IF ( HASONEVALUE ( cohort_retention[month_age] ),",
              "    SUMX ( VALUES ( cohort_retention[cohort_month] ),",
              "        CALCULATE ( MAX ( cohort_retention[cohort_size] ) ) ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Customer continuity"
          },
          {
            "name": "Purchase Retention Rate",
            "expression": [
              "DIVIDE ( [Cohort Active Buyers], [Cohort Eligible Buyers] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "Customer continuity"
          },
          {
            "name": "Product Gross Share",
            "expression": [
              "DIVIDE ( [Gross Sales GBP], CALCULATE ( [Gross Sales GBP], REMOVEFILTERS ( dim_product ) ) )"
            ],
            "formatString": "0.0%",
            "displayFolder": "Financial performance"
          },
          {
            "name": "Product Revenue Rank",
            "expression": [
              "RANKX ( ALLSELECTED ( dim_product ), [Gross Sales GBP], , DESC, DENSE )"
            ],
            "formatString": "#,0",
            "displayFolder": "Customer continuity"
          },
          {
            "name": "Net Deduplicated Scenario GBP",
            "expression": [
              "CALCULATE ( SUM ( fact_invoice_line[amount_pence] ) / 100,",
              "    fact_invoice_line[duplicate_ordinal] = 1,",
              "    KEEPFILTERS ( dim_date[is_complete_period] = TRUE () ) )"
            ],
            "formatString": "\u00a3#,0.00;(\u00a3#,0.00)",
            "displayFolder": "Financial performance"
          },
          {
            "name": "Duplicate Sensitivity GBP",
            "expression": [
              "[Net Merchandise GBP] - [Net Deduplicated Scenario GBP]"
            ],
            "formatString": "\u00a3#,0.00;(\u00a3#,0.00)",
            "displayFolder": "Financial performance"
          },
          {
            "name": "Selected Market Title",
            "expression": [
              "\"Merchandise value | \" & SELECTEDVALUE ( dim_country[country_key], \"Multiple / all markets\" )"
            ],
            "displayFolder": "Customer continuity"
          }
        ]
      },
      {
        "name": "fact_order",
